{
  "permissions": {
    "deny": [
      "Bash(npx velite)",
      "Bash(npx velite *)",
      "Bash(velite)",
      "Bash(velite *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/install_pkgs.sh"
          }
        ]
      }
    ]
  }
}
