# Google AdSense
# 本番・開発で広告を表示する場合に設定（未設定なら広告は表示されません）
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SLOT=xxxxxxxxxx

# JWT（ログイントークンの署名・検証）
# 必須。未設定または32文字未満だと、ログインや認証つきAPIがエラーになる
# 生成コマンド: openssl rand -base64 48（下の change-me は短すぎるので、そのままだとエラーになる）
# 値を変えると発行済みトークンはすべて無効になり、全員ログアウトされる
JWT_SECRET=change-me
