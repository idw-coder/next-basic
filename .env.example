# Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SLOT=xxxxxxxxxx

# GHCRからpull用
# ghp_......

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
# true のときだけ一般ユーザーが決済を始められる（admin は常に可）
STRIPE_CHECKOUT_ENABLED=

# ローカル開発用
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoftログイン（Azureのアプリ登録。サポートするアカウントは「組織ディレクトリと個人のMicrosoftアカウント」）
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# 省略時はリクエストのURLから /api/auth/microsoft/callback を組み立てる。Azureに登録したリダイレクトURIと完全一致が必要
NEXT_MICROSOFT_CALLBACK_URL=
